# ─────────────────────────────────────────────
#  AURA – .gitignore
# ─────────────────────────────────────────────

# --- Secrets & environment ---
.env
*.env

# --- Python virtual environment ---
.venv/
venv/
env/
ENV/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Streamlit ---
.streamlit/secrets.toml

# --- Poppler binaries (large binary dependency) ---
poppler-*/
poppler/

# --- Temporary / scratch files ---
*.tmp
*.bak
*.log

# --- OS ---
desktop.ini

# --- Claude Code local settings ---
.claude/

# --- Project workspace files (not for public repo) ---
README/
AURA_System_Design.docx
AURA_V2_MASTER_PROMPT.md
AURA_V3_MASTER_PROMPT.md
AURA_UI_REDESIGN_PROMPT.md
memory.md
CLAUDE.md

# --- Sample / test data uploads ---
data/uploads/
*.xlsx
!data/samples/*.csv

# --- Node.js / Next.js ---
node_modules/
.next/
out/
.npm
*.tsbuildinfo
.eslintcache

# --- Environment (local overrides) ---
.env.local
.env.*.local
.env.production.local
.env.development.local

# --- Deployment ---
.vercel/
.netlify/

# --- JS/TS test coverage ---
coverage/

# Local dev scaffolding / prompt drafts (keep out of the public repo)
.superpowers/
PROMPT_*.md
GOLDEN_PROMPT_*.xml
data/samples/aura_test_full.csv
