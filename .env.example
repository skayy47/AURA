# ── AURA backend environment ──────────────────────────────────────────────
# Copy to AURA-BACKEND/.env and fill in. Never commit the real .env.

# ── AI provider (pick at least one) ───────────────────────────────────────
# AURA defaults to Groq (FREE, no credit card) and falls back across whatever
# keys are present. Claude / OpenAI are optional PAID upgrades.

# FREE · default · https://console.groq.com/keys  (Llama 3.3 70B)
GROQ_API_KEY=

# PAID · optional · https://platform.openai.com/api-keys  (GPT-4o mini)
OPENAI_API_KEY=

# PAID · optional · https://console.anthropic.com/  (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=

# ── Deployment ────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
# Hosting port (HF Spaces requires 7860; defaults to 8000 locally)
# PORT=7860

# ── Optional ──────────────────────────────────────────────────────────────
DEBUG=0
# Poppler path for PDF→image (Windows local only; the Docker image bundles it)
# POPPLER_PATH=C:\path\to\poppler\Library\bin

# Stripe billing (optional — checkout flow only)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=
